{
  "name": "@sendsprite/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate-cli.ts",
    "db:dev": "bun run scripts/dev-db.ts",
    "worker": "bun run src/worker.ts",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "bunx auth@1.7.1 generate --config src/lib/auth.ts --output src/db/schema/auth.ts -y"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1117.0",
    "@aws-sdk/client-sns": "^3.1117.0",
    "@aws-sdk/client-sts": "^3.1117.0",
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.2",
    "@radix-ui/react-slot": "^1.3.3",
    "@scalar/nextjs-api-reference": "^0.11.16",
    "@sendsprite/shared": "workspace:*",
    "@smithy/node-http-handler": "^4.11.3",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "mailparser": "^3.9.16",
    "next": "^16.3.2",
    "pg-boss": "^12.28.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "selfsigned": "^5.5.0",
    "server-only": "^0.0.1",
    "smtp-server": "^3.19.3",
    "sns-validator": "^0.3.5",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mailparser": "^3.4.6",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "@types/smtp-server": "^3.5.13",
    "aws-sdk-client-mock": "^4.1.0",
    "bun-types": "^1.2.0",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "16.14.0-beta.17",
    "nodemailer": "^9.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
