# ---- Required ----
APP_URL=http://localhost:3000
# generate: openssl rand -base64 48
APP_SECRET=
# Local dev only. Under docker compose DATABASE_URL is derived from POSTGRES_PASSWORD automatically.
DATABASE_URL=postgres://sendsprite:sendsprite@localhost:5432/sendsprite

# ---- Auth providers (each enabled when its variables are set) ----
EMAIL_PASSWORD_ENABLED=true
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=

# ---- Behaviour ----
# auto = open until the first user exists, then invite-only
SIGNUP_MODE=auto
# Comma-separated emails that always have instance-admin access (lockout escape
# hatch). Unset: the first account to sign up is flagged.
#INSTANCE_ADMIN_EMAILS=
LANDING_ENABLED=true
SMTP_ENABLED=true
# Relay port. Under docker compose this is the port published on the host
# (the container always listens on 2587 — a non-root user cannot bind 587).
# STARTTLS uses a self-signed cert unless SMTP_TLS_CERT/SMTP_TLS_KEY point at
# PEM files.
#SMTP_PORT=587
# Dev only: accept AUTH before STARTTLS (the API key is sent in clear)
#SMTP_ALLOW_INSECURE_AUTH=false
# Under docker compose: host directory with the PEM files, mounted at /certs.
#SMTP_TLS_DIR=/etc/letsencrypt/live/mail.example.com
#SMTP_TLS_CERT=/certs/fullchain.pem
#SMTP_TLS_KEY=/certs/privkey.pem
#SMTP_MAX_SIZE=10485760
WORKER_MODE=inline
# Body/attachment retention is set in Settings → Instance (default 90 days).

# ---- Provisioning (Phase 2) ----
# Region preselected in the AWS connect wizard
#AWS_DEFAULT_REGION=us-east-1
# S3 URL of the CloudFormation template used by one-click connect
# Cloudflare OAuth client so Sendsprite can write DNS records itself. Redirect
# URI on the client must be exactly <APP_URL>/api/setup/cloudflare/callback.
#CLOUDFLARE_OAUTH_CLIENT_ID=
#CLOUDFLARE_OAUTH_CLIENT_SECRET=
#CLOUDFLARE_OAUTH_SCOPES=zone.read dns.write offline_access
#CFN_TEMPLATE_URL=https://sendsprite-cfn.s3.us-east-1.amazonaws.com/latest/sendsprite-connect.yaml

# ---- Billing (Phase 5, hosted service only) ----
# Off by default: self-hosted instances have no Billing page and no checkout.
#BILLING_ENABLED=false
# Organization access token and webhook signing secret from the Polar dashboard.
#POLAR_ACCESS_TOKEN=
#POLAR_WEBHOOK_SECRET=
# `sandbox` while developing; omit or `production` in prod.
#POLAR_SERVER=production
# Optional. Display only: shows Polar's own meter balance next to ours.
#POLAR_METER_ID=
# Must match the event name the Polar meter filters on.
#BILLING_EVENT_NAME=email.sent
# Plan a team with no subscription gets: free | pro | scale | unlimited.
# Set it together with BILLING_ENABLED=true: anything but free is refused at boot
# while billing is off. Anything but free grandfathers every existing team at the flip.
#DEFAULT_PLAN=free

# ---- docker-compose only ----
POSTGRES_PASSWORD=sendsprite
